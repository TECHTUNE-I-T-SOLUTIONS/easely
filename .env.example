# Charter Keke Environment Variables
# Copy this file to .env.local and fill in the actual values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# NextAuth Configuration
NEXTAUTH_SECRET=generate_a_random_secret_here
AUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key

# CRM Email Routing (Namecheap Private Email)
CRM_EMAIL_PROVIDER=namecheap_private_email
CRM_EMAIL_DOMAIN=charterkeke.com
CRM_PRIMARY_SUPPORT_INBOX=support@charterkeke.com
CRM_SUPPORT_ALIAS=support@charterkeke.com
CRM_BILLING_ALIAS=billing@charterkeke.com
CRM_OPERATIONS_ALIAS=operations@charterkeke.com
CRM_SAFETY_ALIAS=safety@charterkeke.com
CRM_TECH_ALIAS=tech@charterkeke.com
CRM_EMAIL_IMAP_HOST=imap.privateemail.com
CRM_EMAIL_IMAP_PORT=993
CRM_EMAIL_IMAP_USER=support@charterkeke.com
CRM_EMAIL_IMAP_PASSWORD=your_private_email_password
CRM_EMAIL_SMTP_HOST=smtp.privateemail.com
CRM_EMAIL_SMTP_PORT=465
CRM_EMAIL_SMTP_USER=support@charterkeke.com
CRM_EMAIL_SMTP_PASSWORD=your_private_email_password
CRM_EMAIL_USE_SSL=true
CRM_EMAIL_POLL_INTERVAL_MS=60000
CRM_EMAIL_WEBHOOK_SECRET=your_crm_email_webhook_secret

# SMS Service (Termii)
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=CHARTERKEKE
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_WEBHOOK_SECRET=your_termii_webhook_secret
TERMII_REQUIRE_WEBHOOK_SIGNATURE=false
TERMII_SMS_FALLBACK_TO_GENERIC=true

# Redis Configuration (Optional - for production)
REDIS_URL=redis://localhost:6379
REDIS_TOKEN=your_redis_token

# Payment Gateway (Paystack)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# Admin Dashboard
NEXT_PUBLIC_ADMIN_EMAIL=admin@charterkeke.com
# Optional: prioritize this active admin for mobile diagnostics email delivery
DEVELOPER_ALERT_EMAIL=techtune.it.solutions@gmail.com

# GitHub Releases Access
GITHUB_TOKEN=your_github_token

# Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
